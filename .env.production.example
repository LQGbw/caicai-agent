# 复制为 .env.production 后填写。不要将真实密钥写入仓库或 Docker 镜像。
# 留空 OPENAI_API_KEY 时，应用仍可以以演示模式运行。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 腾讯云在国内访问 Docker Hub 超时时，Compose 默认使用官方镜像的 Public ECR 镜像源。
# 如需改回 Docker Hub，设为 node:22-bookworm-slim。
NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim
